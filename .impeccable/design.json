      "refersTo": "court",
      "description": "Signature: the score pad as a top-down doubles court, white tape on green, scores facing across the net.",
      "html": "<div class=\"ds-court\"><div class=\"ds-tapebox\"><div class=\"ds-alley ds-line-b\"><span class=\"ds-side ds-side-a\">Lið A</span><span class=\"ds-shorts\"><button class=\"ds-short\">Setja 11</button><button class=\"ds-short\">7–0</button></span></div><div class=\"ds-boxes ds-line-b\"><button class=\"ds-box\">Jón</button><button class=\"ds-box\">Óli</button></div><div class=\"ds-front\"><button class=\"ds-minus\" aria-label=\"minus\">−</button><output class=\"ds-score ds-lead\">11</output><button class=\"ds-plus\" aria-label=\"plus\">+</button></div><div class=\"ds-net\"><button class=\"ds-swap\" aria-label=\"swap\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M8 4v15l-3-3M16 20V5l3 3\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button></div><div class=\"ds-front\"><button class=\"ds-minus\" aria-label=\"minus\">−</button><output class=\"ds-score\">7</output><button class=\"ds-plus\" aria-label=\"plus\">+</button></div><div class=\"ds-boxes ds-line-t\"><button class=\"ds-box\">Siggi</button><button class=\"ds-box\"><span class=\"ds-empty\">Tómt</span></button></div><div class=\"ds-alley ds-line-t\"><span class=\"ds-side ds-side-b\">Lið B</span><span class=\"ds-shorts\"><button class=\"ds-short\">Setja 11</button><button class=\"ds-short\">7–0</button></span></div></div></div>",
      "css": ".ds-court{background:var(--color-court,#1f7a4d);padding:12px 16px}.ds-tapebox{border:3px solid #fff}.ds-court button{cursor:pointer}.ds-line-b{border-bottom:3px solid #fff}.ds-line-t{border-top:3px solid #fff}.ds-alley{display:flex;align-items:center;justify-content:space-between;gap:8px;height:44px;padding:0 10px}.ds-side,.ds-short,.ds-box,.ds-minus,.ds-plus,.ds-score{font-family:var(--font-display,'Archivo','Arial Narrow',sans-serif);font-stretch:62%;font-weight:800;letter-spacing:.01em;text-transform:uppercase;}.ds-side{padding:2px 10px;border-radius:4px;font-size:1rem;letter-spacing:.04em}.ds-side-a{background:#fff;color:var(--color-win,#1a6b43)}.ds-side-b{background:var(--color-challenge,#1d4f96);color:#fff}.ds-shorts{display:flex;gap:6px}.ds-short{height:32px;padding:0 12px;border:2px solid #fff;border-radius:4px;background:transparent;color:#fff;font-size:.875rem;letter-spacing:.04em}.ds-short:hover,.ds-short:active{background:#fff;color:var(--color-court,#1f7a4d)}.ds-boxes{display:grid;grid-template-columns:1fr 1fr}.ds-box{height:48px;border:0;background:transparent;color:#fff;font-size:1.375rem}.ds-box:first-child{border-right:3px solid #fff}.ds-empty{font-family:var(--font-body,'Archivo',sans-serif);font-stretch:100%;font-weight:500;font-size:.875rem;text-transform:none}.ds-front{display:flex;align-items:center;justify-content:space-between;padding:6px 10px}.ds-minus,.ds-plus{display:flex;align-items:center;justify-content:center;width:48px;height:48px;border-radius:4px;font-size:2rem}.ds-minus{border:3px solid #fff;background:transparent;color:#fff}.ds-minus:active{background:var(--color-court-deep,#14573a)}.ds-plus{border:0;background:#fff;color:var(--color-court,#1f7a4d)}.ds-plus:active{background:var(--color-shuttle,#f4d23c)}.ds-score{font-size:4rem;line-height:.85;color:#fff;font-variant-numeric:tabular-nums}.ds-lead{color:var(--color-shuttle,#f4d23c)}.ds-net{display:flex;align-items:center;justify-content:center;height:40px;border-top:4px solid #fff;background-color:var(--color-court-deep,#14573a);background-image:linear-gradient(to right,rgb(255 255 255/.22) 1px,transparent 1px),linear-gradient(to bottom,rgb(255 255 255/.22) 1px,transparent 1px);background-size:7px 7px}.ds-swap{display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:9999px;border:3px solid var(--color-court-deep,#14573a);background:#fff;color:var(--color-court,#1f7a4d)}.ds-swap:active{background:var(--color-shuttle,#f4d23c)}.ds-court button:focus-visible{outline:3px solid var(--color-challenge,#1d4f96);outline-offset:2px}"
    },
    {
      "name": "Run Strip",
      "kind": "custom",
      "refersTo": "badge-run",
      "description": "Strip above the court naming the pair holding it; turns yellow when the pair must split.",
      "html": "<div class=\"ds-strip\"><span class=\"ds-count ds-count-hot\">2</span><div><p class=\"ds-pair\">Jón &amp; Óli</p><p class=\"ds-note\">2 í röð · 1 í heiðurinn</p></div></div><div class=\"ds-strip ds-strip-split\"><span class=\"ds-count ds-count-split\">3</span><div><p class=\"ds-pair\">Jón &amp; Óli</p><p class=\"ds-note\">3 í röð — parið splittast núna</p></div></div>",
      "css": ".ds-strip{display:flex;align-items:center;gap:12px;margin-top:8px;padding:10px 12px;border-radius:4px;background:var(--color-surface,#fff)}.ds-strip-split{background:var(--color-shuttle,#f4d23c)}.ds-count{font-family:var(--font-display,'Archivo','Arial Narrow',sans-serif);font-stretch:62%;font-weight:800;letter-spacing:.01em;text-transform:uppercase;display:flex;align-items:center;justify-content:center;flex-shrink:0;width:40px;height:40px;border-radius:4px;font-size:1.625rem;font-variant-numeric:tabular-nums}.ds-count-hot{background:var(--color-shuttle,#f4d23c);color:var(--color-ink,#16201a)}.ds-count-split{background:var(--color-ink,#16201a);color:var(--color-shuttle,#f4d23c)}.ds-pair{font-family:var(--font-display,'Archivo','Arial Narrow',sans-serif);font-stretch:62%;font-weight:800;letter-spacing:.01em;text-transform:uppercase;margin:0;font-size:1.125rem;line-height:1.25;color:var(--color-ink,#16201a)}.ds-note{margin:0;font-size:.875rem;color:var(--color-ink-muted,#46524a)}"
    }
  ],
  "narrative": {
    "northStar": "The Hall Is the Interface",
    "overview": "The app is drawn from the sports hall it is used in. The ground is a cool, light hall floor under bright overhead lighting; content sits on it as flat white fields, like panels laid on the boards. The court mat is green, the only marks on green are white line tape, and the one bright thing you reach for is shuttle-tube yellow. Nothing glows and nothing floats: the previous dark arena with neon glows was deliberately left behind, and so was the generic white rounded-card tracker.\n\nDensity is phone-courtside: one column, at most 480px, big touch targets, and every number in tabular figures so scores never jog. Type is a single family, Archivo, split by its width axis: extra-condensed heavy caps for names, scores and headings, normal width for anything you actually read. The signature is the score pad drawn as a top-down doubles court; the brand mark is the same court in miniature, with the net in yellow.\n\nFull-screen moments flip the ground rather than adding effects: a run of three turns the whole screen shuttle yellow, a 7–0 turns it ink.",
    "keyCharacteristics": [
      "Light hall-floor ground, white flat fields, no borders at rest, no shadows.",
      "Court green for the court, the side holding it, and every win; white tape as the only lines on green.",
      "Shuttle yellow for the one primary action, runs and honors; challenger blue for the other side.",
      "Archivo throughout, width axis doing the work: 62% caps for display, normal width for body.",
      "Tight 4px corners, like taped lines; pills only for players and toggles.",
      "An ink tab bar anchors the bottom."
    ],
    "rules": [
      {
        "name": "The Tape Rule",
        "body": "On green, the only lines and text are white tape (3px strokes on the court). No tints, no greys, no outlines in other colors; the leading score is the single exception and it turns shuttle yellow.",
        "section": "colors"
      },
      {
        "name": "The One Yellow Button Rule",
        "body": "A screen has one shuttle-yellow action, full width, ink text. Every other action is blue, outlined or plain.",
        "section": "colors"
      },
      {
        "name": "The Two Sides Rule",
        "body": "Green is the side holding the court and every win; blue is the challenger. Do not swap them or use either decoratively.",
        "section": "colors"
      },
      {
        "name": "The Width Axis Rule",
        "body": "Hierarchy comes from width and weight in one family. Never introduce a second display face.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every score, record and count uses tabular figures.",
        "section": "typography"
      },
      {
        "name": "The Label Not Kicker Rule",
        "body": "The label style names a control, a form field, a region inside a card, or a back link. It never sits above a page or section heading as a kicker.",
        "section": "typography"
      },
      {
        "name": "The No Glow Rule",
        "body": "Nothing glows, blurs or floats. State is a solid inset edge or a fill change.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the page on the hall floor (canvas) with flat white fields for content.",
      "Do draw anything on green with white tape only, at 3px.",
      "Do give each screen exactly one full-width shuttle-yellow action with ink text.",
      "Do use green for the side holding the court and for wins, blue for the challenger.",
      "Do set scores, names and headings in Archivo at 62% width, weight 800, uppercase, with tabular figures for numbers.",
      "Do mark live or record state with a 2px inset edge, not a shadow.",
      "Do keep corners at 4px, reserving pills for players, toggles and avatars."
    ],
    "donts": [
      "Don't add drop shadows, glows or blurs; the dark neon arena is the rejected world.",
      "Don't set shuttle yellow as text on the light floor; use flame for readable run text.",
      "Don't use the label style as a kicker above a heading.",
      "Don't introduce a second typeface or a system display face.",
      "Don't use danger red for anything but deletion and errors.",
      "Don't round cards beyond 4px or give them visible borders at rest."
    ]
  }
}