      "html": "<button class=\"ds-btn-primary\">Skrá úrslit 21–17</button><button class=\"ds-btn-primary\" disabled>Veldu fjóra leikmenn</button>",
      "css": ".ds-btn-primary{font-family:var(--font-display,'Archivo','Arial Narrow',sans-serif);font-stretch:62%;font-weight:800;letter-spacing:.01em;text-transform:uppercase;display:block;width:100%;height:60px;margin-top:8px;border:0;border-radius:var(--radius-lg,4px);background:var(--color-shuttle,#f4d23c);color:var(--color-ink,#16201a);font-size:1.5rem;cursor:pointer;transition:background-color .15s}.ds-btn-primary:active{background:#e6c22a}.ds-btn-primary:focus-visible{outline:3px solid var(--color-challenge,#1d4f96);outline-offset:2px}.ds-btn-primary:disabled{background:var(--color-surface-raised,#e3e8e2);color:var(--color-ink-faint,#5e6a62);cursor:default}"
