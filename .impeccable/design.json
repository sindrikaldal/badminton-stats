      "html": "<label class=\"ds-label\" for=\"ds-code\">Aðgangskóði</label><input id=\"ds-code\" class=\"ds-input\" value=\"1234\">",
      "css": ".ds-label{display:block;font-family:var(--font-display,'Archivo',sans-serif);font-stretch:75%;font-weight:700;font-size:.8125rem;letter-spacing:.06em;text-transform:uppercase;color:var(--color-ink-faint,#5e6a62)}.ds-input{font-family:var(--font-display,'Archivo','Arial Narrow',sans-serif);font-stretch:62%;font-weight:800;letter-spacing:.01em;text-transform:uppercase;display:block;width:100%;margin-top:8px;padding:14px 16px;border:1px solid var(--color-line,#d5dcd4);border-radius:var(--radius-lg,4px);background:var(--color-surface-input,#fff);color:var(--color-ink,#16201a);font-size:1.5rem;letter-spacing:.2em;text-align:center;outline:none}.ds-input:focus{border-color:var(--color-challenge,#1d4f96)}"
    },
    {
      "name": "Player Chips",
      "kind": "chip",
      "refersTo": "player-chip",
      "description": "Pills for picking players; fill shows which side of the net each player is on.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip ds-chip-a\" aria-pressed=\"true\">Jón</button><button class=\"ds-chip ds-chip-b\" aria-pressed=\"true\">Siggi</button><button class=\"ds-chip\" aria-pressed=\"false\">Óli</button></div>",
      "css": ".ds-chips{display:flex;flex-wrap:wrap;gap:6px}.ds-chip{font-family:var(--font-display,'Archivo','Arial Narrow',sans-serif);font-stretch:62%;font-weight:800;letter-spacing:.01em;text-transform:uppercase;height:36px;padding:0 12px;border:2px solid var(--color-line,#d5dcd4);border-radius:9999px;background:var(--color-surface,#fff);color:var(--color-ink,#16201a);font-size:1rem;cursor:pointer;transition:background-color .15s,border-color .15s}.ds-chip:hover{border-color:var(--color-line-bright,#b9c3b8)}.ds-chip:focus-visible{outline:3px solid var(--color-challenge,#1d4f96);outline-offset:2px}.ds-chip-a,.ds-chip-a:hover{border-color:var(--color-win,#1a6b43);background:var(--color-win,#1a6b43);color:#fff}.ds-chip-b,.ds-chip-b:hover{border-color:var(--color-challenge,#1d4f96);background:var(--color-challenge,#1d4f96);color:#fff}"
    },
    {
      "name": "Standings Card",
      "kind": "card",
      "refersTo": "card",
      "description": "A flat white field holding a divided list; the leader row gets the win wash, a run gets a yellow badge.",
      "html": "<ul class=\"ds-card\"><li class=\"ds-row ds-row-lead\"><span class=\"ds-av ds-av-court\">JÓ</span><span class=\"ds-name\">Jón</span><span class=\"ds-run\">2 í röð</span><span class=\"ds-wl ds-wl-win\">4–1</span></li><li class=\"ds-row\"><span class=\"ds-av ds-av-ink\">SI</span><span class=\"ds-name\">Siggi</span><span class=\"ds-wl\">2–3</span></li><li class=\"ds-row\"><span class=\"ds-av ds-av-white\">ÓL</span><span class=\"ds-name\">Óli</span><span class=\"ds-seven\">7–0</span><span class=\"ds-wl\">1–1</span></li></ul>",
      "css": ".ds-card{list-style:none;margin:0;padding:0;overflow:hidden;background:var(--color-surface,#fff);border:1px solid transparent;border-radius:var(--radius-card,4px)}.ds-row{display:flex;align-items:center;gap:12px;padding:10px 12px;border-top:1px solid var(--color-line,#d5dcd4)}.ds-row:first-child{border-top:0}.ds-row-lead{background:var(--color-win-dim,#d9ebe0)}.ds-av{font-family:var(--font-display,'Archivo','Arial Narrow',sans-serif);font-stretch:62%;font-weight:800;letter-spacing:.01em;text-transform:uppercase;display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:9999px;border:2px solid;font-size:.75rem;letter-spacing:.04em}.ds-av-ink{background:var(--color-ink,#16201a);border-color:var(--color-ink,#16201a);color:#fff}.ds-av-court{background:var(--color-court,#1f7a4d);border-color:var(--color-court,#1f7a4d);color:#fff}.ds-av-white{background:#fff;border-color:var(--color-ink,#16201a);color:var(--color-ink,#16201a)}.ds-name{font-family:var(--font-display,'Archivo','Arial Narrow',sans-serif);font-stretch:62%;font-weight:800;letter-spacing:.01em;text-transform:uppercase;flex:1;font-size:1.125rem;color:var(--color-ink,#16201a)}.ds-run,.ds-seven{font-family:var(--font-display,'Archivo','Arial Narrow',sans-serif);font-stretch:62%;font-weight:800;letter-spacing:.01em;text-transform:uppercase;padding:2px 6px;border-radius:4px;font-size:.875rem;letter-spacing:.04em}.ds-run{background:var(--color-shuttle,#f4d23c);color:var(--color-ink,#16201a)}.ds-seven{background:var(--color-ink,#16201a);color:var(--color-canvas,#eef1ec)}.ds-wl{font-family:var(--font-display,'Archivo','Arial Narrow',sans-serif);font-stretch:62%;font-weight:800;letter-spacing:.01em;text-transform:uppercase;font-variant-numeric:tabular-nums;font-size:1.25rem;color:var(--color-ink-muted,#46524a)}.ds-wl-win{color:var(--color-win,#1a6b43)}"
    },
